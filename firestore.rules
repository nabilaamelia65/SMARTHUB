rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'tadrisipab35@gmail.com'
      );
    }

    function isTeacherOrStaff() {
      return isSignedIn();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Classes collection
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Lesson schedules collection
    match /lessonSchedules/{scheduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Lesson sessions collection
    match /lessonSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrStaff();
      allow update: if isTeacherOrStaff() && (
        existing().teacherId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // School tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isTeacherOrStaff();
      allow update: if isTeacherOrStaff() && (
        existing().teacherId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Staff attendance collection
    match /staffAttendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
